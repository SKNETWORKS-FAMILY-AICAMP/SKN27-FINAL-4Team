# ── 환경변수 템플릿 ──────────────────────────────────────────
# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요.  (.env 는 git에 안 올라감)
#   cp .env.example .env
#
# ⚠️ 보안 기본값 변경(2026-07-15): settings.py가 이제 아래를 .env에서 읽습니다.
#    개발 로컬은 DEBUG=True / ALLOWED_HOSTS=* 를 반드시 넣어야 기존처럼 동작합니다.

# ── Django ──
# 새 키 생성:  python -c "import secrets;print('django-insecure-'+secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-key
DEBUG=True                    # 운영은 False
ALLOWED_HOSTS=*               # 운영은 실제 도메인(콤마구분)

# ── 채팅 DB 암호화 (Fernet 대칭키 · 미설정 시 평문 저장) ──
# 새 키 생성:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 이 키를 잃어버리면 암호화된 대화는 복호화 불가 — 안전하게 보관/고정.
CHAT_ENC_KEY=

# ── PostgreSQL ──
PG_DB=wellness_db
PG_USER=postgres
PG_PASSWORD=change-me
PG_HOST=localhost
PG_PORT=5432

# ── Neo4j (GraphDB 장기기억 · 선택: 미설정 시 자동 no-op) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ── LLM ──
OPENAI_API_KEY=
# OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ── TTS 공급자 선택 (elevenlabs | typecast) ──
TTS_PROVIDER=elevenlabs

# ── TTS: Typecast (자연스러운 한국어 · smart emotion) ──
TYPECAST_API_KEY=
# 캐릭터별 Typecast voice_id (tc_... 형식, /v2/voices 로 조회)
TYPECAST_VOICE_PORI=
TYPECAST_VOICE_KKAMI=
TYPECAST_VOICE_TOTO=
TYPECAST_VOICE_YEOUL=

# ── TTS: ElevenLabs ──
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOICE_ID_PORI=
VOICE_ID_KKAMI=
VOICE_ID_TOTO=
VOICE_ID_YEOUL=

# ── 소셜 로그인(카카오/네이버/구글) ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 날씨 (기상청 공공데이터포털 서비스키) ──
KMA_API_KEY=

# ── 책 추천 (네이버 검색 Open API) ──
NAVER_BOOK_CLIENT_ID=
NAVER_BOOK_CLIENT_SECRET=

# ── 기타 ──
FRONTEND_BASE_URL=http://localhost:5173
