# ── LLM 공급자 선택 (openai 기본 / groq) ──
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# (groq 쓸 경우)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# ── PostgreSQL (필수 — docker compose 사용 시 기본값 그대로) ──
PG_HOST=localhost
PG_PORT=5432
PG_DB=wellness_db
PG_USER=postgres
PG_PASSWORD=password

# ── Tavily 웹검색 (선택 — plan-support용, 없으면 빈 결과) ──
TAVILY_API_KEY=

# ── Redis (선택 — 지정 시에만 Redis 캐시 사용, 기본: 인메모리) ──
# REDIS_URL=redis://127.0.0.1:6379/1

# ── ElevenLabs TTS (선택 — 없으면 음성만 비활성, 대화는 정상) ──
# voice_id 4종은 Voice Library에서 팀 선정 후 입력
ELEVENLABS_API_KEY=
VOICE_ID_PORI=
VOICE_ID_KKAMI=
VOICE_ID_TOTO=
VOICE_ID_YEOUL=
